{
  "expo": {
    "name": "تسليم",
    "slug": "tasleem-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c6679"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c6679"
      },
      "package": "com.skafeerr.tasleem",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح لتسليم بالوصول إلى صورك لرفع صور المنتجات"
        }
      ]
    ],
    "scheme": "tasleem",
    "extra": {
      "eas": {
        "projectId": "46e2ebf7-2473-485d-8334-4ce2a12e4e53"
      }
    }
  }
}
